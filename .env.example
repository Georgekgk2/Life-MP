# =============================================================================
# Локальне середовище розробки Life-MP
# =============================================================================
# Усі значення нижче навмисно не є секретами та призначені ЛИШЕ для локального
# Docker Compose та розробки. Не використовуйте їх у shared, staging або production.
# Виробничий режим (NODE_ENV=production) СУВОРO відхиляє ці значення за замовчуванням.

# -----------------------------------------------------------------------------
# Локальні сервіси даних (docker-compose.dev.yml)
# -----------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54329
POSTGRES_DB=life_medusa_dev
POSTGRES_USER=life_medusa_dev
POSTGRES_PASSWORD=life_medusa_dev_password

# Application Databases & Credentials (Non-Superuser Roles)
DATABASE_URL=postgresql://life_medusa_dev:life_medusa_dev_password@127.0.0.1:54329/life_medusa_dev
TEST_DATABASE_URL=postgresql://life_medusa_test:life_medusa_test_password@127.0.0.1:54329/life_medusa_test
MIGRATION_TEST_DATABASE_URL=postgresql://life_medusa_migration_test:life_medusa_migration_test_password@127.0.0.1:54329/life_medusa_migration_test

# Medusa test runner control connection (superuser is used only to create/drop
# isolated test databases; application connections remain non-superuser).
TEST_RUNNER_DATABASE_URL=postgresql://life_local:life_local_password@127.0.0.1:54329/postgres

REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379

# Local Security Sentinels (Mandatory Rejection in Production)
JWT_SECRET=local_jwt_secret_change_me_in_production
COOKIE_SECRET=local_cookie_secret_change_me_in_production

# Синтетичні sandbox-можливості вмикаються явно для окремої команди та ніколи не дійсні у production.
# ALLOW_SYNTHETIC_CATALOG=false
# ALLOW_SYNTHETIC_ORDERS=false
# ALLOW_SYNTHETIC_REVIEWS=false

# URL Commerce для браузера storefront (лише локальна розробка; секретів тут немає).
MEDUSA_BACKEND_URL=http://127.0.0.1:9000
NEXT_PUBLIC_MEDUSA_API_URL=http://127.0.0.1:9000

# CORS
STORE_CORS=http://localhost:3000,http://127.0.0.1:3100
ADMIN_CORS=http://localhost:7001,http://127.0.0.1:7001
AUTH_CORS=http://localhost:3000,http://127.0.0.1:3100,http://127.0.0.1:7001
