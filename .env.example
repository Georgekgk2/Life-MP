# =============================================================================
# Локальне середовище розробки Life-MP
# =============================================================================
# Усі значення нижче навмисно не є секретами та призначені ЛИШЕ для локального
# Docker Compose. Не використовуйте їх у shared, staging або production середовищах.
# Скопіюйте файл до .env лише якщо локальному застосунку потрібні ці URL.

# -----------------------------------------------------------------------------
# Локальні сервіси даних (docker-compose.dev.yml)
# -----------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54329
POSTGRES_DB=life_local
POSTGRES_USER=life_local
POSTGRES_PASSWORD=life_local_password
DATABASE_URL=postgresql://life_local:life_local_password@127.0.0.1:54329/life_local

REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379
