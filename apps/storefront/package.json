{
  "name": "@life/storefront",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check package.json tsconfig.json next.config.ts next-env.d.ts app src test e2e"
  },
  "dependencies": {
    "@life/types": "workspace:*",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "26.5.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "engines": {
    "node": ">=22"
  }
}
