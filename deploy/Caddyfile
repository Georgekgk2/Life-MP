# UNAPPROVED TEMPLATE — DO NOT DEPLOY (Phase P0 Containment)
# Life-MP Caddyfile — Reverse Proxy Template
# =============================================================================
# УВАГА: production-розгортання заблоковано.
# Використовуйте placeholder-домени на зразок marketplace.example.invalid.
# =============================================================================

{$DOMAIN:localhost} {
    # Storefront
    handle_path /api/* {
        reverse_proxy commerce:9000
    }

    handle {
        reverse_proxy storefront:3000
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Gzip
    encode gzip

    # Logging
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
