# =============================================================================
# UNAPPROVED TEMPLATE — DO NOT DEPLOY (Phase P0 Containment)
# Storefront — Multi-stage Next.js Production Build
# =============================================================================

# --- Stage 1: Install dependencies ---
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS deps
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/storefront/package.json ./apps/storefront/
COPY packages/types/package.json ./packages/types/
COPY packages/config/package.json ./packages/config/
COPY packages/braces/package.json ./packages/braces/

RUN pnpm install --frozen-lockfile --filter @life/storefront... --filter @life/config...

# --- Stage 2: Build ---
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS builder
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate
WORKDIR /app

ARG NEXT_PUBLIC_MEDUSA_API_URL=/api
ENV NEXT_PUBLIC_MEDUSA_API_URL=$NEXT_PUBLIC_MEDUSA_API_URL

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/storefront/node_modules ./apps/storefront/node_modules
COPY --from=deps /app/packages/config/node_modules ./packages/config/node_modules

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/storefront ./apps/storefront
COPY packages/types ./packages/types
COPY packages/config ./packages/config
COPY packages/braces ./packages/braces

RUN pnpm --filter @life/types build
RUN pnpm --filter @life/config build
RUN pnpm --filter @life/storefront build

# --- Stage 3: Production runtime ---
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runner
RUN apk upgrade --no-cache && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=builder --chown=nextjs:nodejs /app/apps/storefront/public ./apps/storefront/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/storefront/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/storefront/.next/static ./apps/storefront/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/packages/braces ./packages/braces

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=15s \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/storefront/server.js"]
